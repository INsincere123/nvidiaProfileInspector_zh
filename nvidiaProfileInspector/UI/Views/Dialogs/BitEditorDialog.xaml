<Window
    x:Class="nvidiaProfileInspector.UI.Views.Dialogs.BitEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:nvidiaProfileInspector.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:nvidiaProfileInspector.UI.Controls"
    xmlns:converters="clr-namespace:nvidiaProfileInspector.UI.Converters;assembly=nvidiaProfileInspector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:nvidiaProfileInspector.UI.ViewModels"
    Title="{loc:Text Bit_Value_Editor_bea690}"
    Width="1241"
    Height="864"
    MinHeight="864"
    MaxHeight="1320"
    d:DataContext="{x:Static vm:DesignTimeData.BitEditorViewModel}"
    SizeToContent="Manual"
    Style="{StaticResource DarkDialogWindowStyle}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style
            x:Key="BitEditorListViewItemStyle"
            BasedOn="{StaticResource DarkListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Padding" Value="{DynamicResource ListItemPadding}" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BitEditorGridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Layer2BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar (Draggable Area)  -->
        <Border
            Grid.Row="0"
            Padding="24,12,0,0"
            Background="Transparent">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{loc:Text Bit_Value_Editor_bea690}" />

                <StackPanel
                    Grid.Column="1"
                    Margin="0,-12,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="Close_Click"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="{loc:Text Close_bbfa77}">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconClose}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Content  -->
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{loc:Text Inspect_individual_flag_bits_compare_them_a1722e}"
                TextWrapping="Wrap" />

            <controls:SearchableTextBox
                x:Name="FilterTextBox"
                Grid.Row="1"
                Margin="0,0,0,12"
                Placeholder="{loc:Text ProfileFilterPlaceholder}"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{loc:Text Filter_scanned_profile_names_593003}" />

            <Grid Grid.Row="2" MinHeight="360">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    Padding="10,6"
                    Background="{DynamicResource NvidiaGreenBrush}"
                    BorderBrush="{DynamicResource NvidiaGreenPressedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasMatchesAboveVisibleRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="M 12 4 L 20 12 L 16 12 L 16 20 L 8 20 L 8 12 L 4 12 Z"
                            Fill="{DynamicResource TextOnAccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Text="{Binding MatchesAboveVisibleRange, StringFormat={}{0} matches above the visible area}" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="BitsListView"
                    Grid.Row="1"
                    MinHeight="360"
                    AlternationCount="2"
                    ItemContainerStyle="{StaticResource BitEditorListViewItemStyle}"
                    ItemsSource="{Binding FilteredBits}"
                    Loaded="BitsListView_Loaded"
                    SelectionMode="Single"
                    SizeChanged="BitsListView_SizeChanged"
                    Style="{StaticResource DarkListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource BitEditorGridHeaderStyle}">
                            <GridViewColumn Header="#">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BitLabel}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Enabled_df174a}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkCheckBoxStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Description_55f8eb}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaskDescription}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Count_66e129}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProfileCount}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:Text Profiles_0c2a93}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VisibleProfileNames}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Padding="10,6"
                    Background="{DynamicResource NvidiaGreenBrush}"
                    BorderBrush="{DynamicResource NvidiaGreenPressedBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasMatchesBelowVisibleRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="M 8 4 L 16 4 L 16 12 L 20 12 L 12 20 L 4 12 L 8 12 Z"
                            Fill="{DynamicResource TextOnAccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            Text="{Binding MatchesBelowVisibleRange, StringFormat={}{0} matches below the visible area}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="410" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16"
                    Background="{DynamicResource Layer2BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{loc:Text Test_Area_a46eab}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{loc:Text Apply_the_edited_value_to_the_324627}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBox
                            x:Name="GamePathTextBox"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,12,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DarkTextBoxStyle}"
                            Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{loc:Text Game_executable_path_135eb5}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="96"
                            Margin="0,12,8,0"
                            Padding="12,6"
                            Click="Browse_Click"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="{loc:Text Browse_for_game_executable_ad9d84}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{DynamicResource IconFolder}"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" Text="{loc:Text Browse_2f3b5c}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            MinWidth="140"
                            Margin="0,12,0,0"
                            Padding="12,6"
                            Command="{Binding ApplyAndLaunchCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="{loc:Text Apply_changes_and_launch_game_05c939}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{DynamicResource IconGame}"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Stretch="Uniform" />
                                <TextBlock VerticalAlignment="Center" Text="{loc:Text Apply_Launch_016033}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{DynamicResource Layer2BackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.ColumnSpan="2"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="{loc:Text Current_Value_4f9931}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{loc:Text Review_and_apply_the_current_bitmask_30a843}" />
                        <Grid
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Text="{loc:Text Value_2139d7}" />
                            <TextBox
                                x:Name="CurrentValueTextBox"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsReadOnly="True"
                                Style="{StaticResource DarkTextBoxStyle}"
                                Text="{Binding CurrentValueHex, Mode=OneWay}"
                                ToolTip="{loc:Text Current_DWORD_value_ab05f1}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="96"
                                Padding="12,6"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="{loc:Text Apply_bit_changes_9c7ff4}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Data="{DynamicResource IconApply}"
                                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Stretch="Uniform" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Text Apply_cfea41}" />
                                </StackPanel>
                            </Button>
                            <Button
                                IsCancel="True"
                                Grid.Column="3"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Click="Close_Click"
                                Content="{loc:Text Close_bbfa77}"
                                Style="{StaticResource DarkButtonStyle}"
                                ToolTip="{loc:Text Close_without_saving_e45919}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="4"
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </Grid>
    </Grid>
</Window>
