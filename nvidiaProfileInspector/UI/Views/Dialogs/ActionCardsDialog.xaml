<Window
    x:Class="nvidiaProfileInspector.UI.Views.Dialogs.ActionCardsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:loc="clr-namespace:nvidiaProfileInspector.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:nvidiaProfileInspector.UI.Controls"
    Title="{loc:Text Actions_c3cd63}"
    Width="550"
    Height="Auto"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource DarkDialogWindowStyle}"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title Bar (Draggable Area)  -->
        <Border
            Grid.Row="0"
            Padding="24,12,0,0"
            Background="Transparent">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Back Button  -->
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="Back_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="{loc:Text Go_back_e84712}"
                    Visibility="Collapsed"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path
                        Width="10"
                        Height="10"
                        Data="M10,2 L2,10 L10,18"
                        Stretch="Uniform"
                        Stroke="{DynamicResource TextPrimaryBrush}"
                        StrokeThickness="2" />
                </Button>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="0,-12,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="Cancel_Click"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="{loc:Text Close_bbfa77}">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconClose}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Description/Subtitle  -->
        <Border Grid.Row="1" Padding="24,12,24,0">
            <TextBlock
                x:Name="SubtitleTextBlock"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Border>

        <!--  View Container  -->
        <Grid Grid.Row="2">
            <!--  Cards View  -->
            <ItemsControl x:Name="CardsContainer" Margin="24,24,24,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ChoiceCard
                            Title="{Binding Title}"
                            Click="Card_Click"
                            Description="{Binding Description}"
                            IconFill="{Binding IconFill}"
                            IconPath="{Binding IconPath}"
                            Tag="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Profile Selection View  -->
            <Grid
                x:Name="SelectionContainer"
                Margin="24,12,24,24"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    x:Name="ProfilesListBox"
                    Grid.Row="0"
                    Height="350"
                    ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Style="{StaticResource DarkListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                Margin="4"
                                Content="{Binding ProfileName}"
                                FontSize="13"
                                IsChecked="{Binding IsSelected}"
                                Style="{StaticResource DarkCheckBoxStyle}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button
                            MinWidth="40"
                            Margin="0,0,4,0"
                            Padding="8,4"
                            Click="SelectAll_Click"
                            Content="{loc:Text All_6a7208}"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="{loc:Text Select_all_profiles_48877a}" />
                        <Button
                            MinWidth="40"
                            Margin="0,0,4,0"
                            Padding="8,4"
                            Click="SelectNone_Click"
                            Content="{loc:Text None_6eef66}"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="{loc:Text Deselect_all_profiles_63ba35}" />
                        <Button
                            MinWidth="40"
                            Padding="8,4"
                            Click="Invert_Click"
                            Content="{loc:Text Invert_e84469}"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="{loc:Text Invert_selection_e074f0}" />
                    </StackPanel>

                    <CheckBox
                        x:Name="IncludePredefinedCheckBox"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{loc:Text Include_predefined_settings_fd7dd5}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Selection Footer (only for selection view)  -->
        <Border
            x:Name="SelectionFooter"
            Grid.Row="3"
            Padding="24"
            Background="{DynamicResource Layer2BackgroundBrush}"
            CornerRadius="0,0,8,8"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    Content="{loc:Text Cancel_77dfd2}"
                    Style="{StaticResource DarkButtonStyle}"
                    ToolTip="{loc:Text Cancel_and_close_9fa770}" />
                <Button
                    MinWidth="120"
                    Click="ExportSelected_Click"
                    Content="{loc:Text Export_Selected_a2015a}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTip="{loc:Text Export_selected_profiles_166370}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
